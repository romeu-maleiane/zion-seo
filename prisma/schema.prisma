// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Store {
  id              String            @id @default(uuid())
  storeId         String            @unique
  storeName       String
  storeDomain     String            @unique
  email           String            @unique
  products        Product[]
  collections     Collection[]
  pages           Page[]
  blogs           Blog[]
  llmDotTxtConfig LLMDotTxtConfig[]
  activePlan      String            @default("free")
  aiCredits       Int               @default(20)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Product {
  id                       String    @id @default(uuid())
  productId                String    @unique
  productImage             String?
  productPrice             Float?
  productUrl               String?
  storeId                  String
  store                    Store     @relation(fields: [storeId], references: [storeId])
  title                    String
  currentDescription       String
  currentMetaTitle         String
  currentMetaDescription   String
  generatedDescription     String?
  generatedMetaTitle       String?
  generatedMetaDescription String?
  showForLlms              Boolean   @default(true)
  isOptimized              Boolean   @default(false)
  createdAt                DateTime  @default(now())
  descriptionOptimizedAt   DateTime?
  metaDataOptimizedAt      DateTime?
  updatedAt                DateTime  @updatedAt
}

model Collection {
  id              String   @id @default(uuid())
  collectionId    String   @unique
  collectionImage String?
  collectionUrl   String
  storeId         String
  store           Store    @relation(fields: [storeId], references: [storeId])
  title           String
  description     String
  showForLlms     Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model Page {
  id        String   @id @default(uuid())
  pageId    String   @unique
  pageUrl   String
  storeId   String
  store     Store    @relation(fields: [storeId], references: [storeId])
  title     String
  updatedAt DateTime @updatedAt
}

model Blog {
  id        String   @id @default(uuid())
  blogId    String   @unique
  blogUrl   String
  storeId   String
  store     Store    @relation(fields: [storeId], references: [storeId])
  title     String
  updatedAt DateTime @updatedAt
}

model LLMDotTxtConfig {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [storeId])
  llmDotTxtDescription String?
  includeProducts Boolean @default(true)
  includeCollections Boolean @default(true)
  includeBlogs Boolean @default(true)
  includePages Boolean @default(true)
  selectAllProducts Boolean @default(true)
  selectedProducts Boolean @default(false)
  exceptSelectedProducts Boolean @default(false)
  selectAllCollections Boolean @default(true)
  selectedCollections Boolean @default(false)
  exceptSelectedCollections Boolean @default(false)
  selectChatGPT Boolean @default(true)
  selectGemini Boolean @default(true)
  selectGrok Boolean @default(true)
  selectDeepSeek Boolean @default(true)
  selectClaude Boolean @default(true)
  selectPerplexity Boolean @default(true)
}
